# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for authentication tokens (falls back to generated runtime secret if unset)
JWT_SECRET="CHANGE_ME_IN_PRODUCTION"

# STORAGE_PATH: Local path for uploaded project archives and backups
STORAGE_PATH="./storage"

# VITE_API_BASE_URL: Frontend API base path (defaults to /api when served from Express)
VITE_API_BASE_URL="/api"
